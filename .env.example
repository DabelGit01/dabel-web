# Supabase Postgres — the only database (percent-encode special chars in the password, e.g. % -> %25)
# App (transaction pooler):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=15&pool_timeout=20"
# Migrations (session pooler):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# iron-session cookie secret — at least 32 random characters
SESSION_COOKIE_PASSWORD="replace-with-a-long-random-secret-of-32+-chars"

# Initial super admin (used once by `npx prisma db seed`)
ADMIN_EMAIL="admin@dabel.ng"
ADMIN_PASSWORD="replace-me-10+-chars"

NEXT_PUBLIC_API_URL="http://localhost:3000"

# Supabase storage (admin image uploads go through /api/admin/upload)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
NEXT_PUBLIC_SUPABASE_BUCKET="dabel-media"
